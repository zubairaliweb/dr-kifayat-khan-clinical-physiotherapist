# Server
PORT=3000
NODE_ENV=production

# Admin access
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_TOKEN=replace_with_a_strong_random_token

# MongoDB (optional; app falls back to local JSON storage if not configured)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=physiotherapy_portal

# Optional: keep these values in your hosting provider's environment variables instead of committing them.
